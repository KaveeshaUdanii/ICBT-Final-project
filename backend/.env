# Copy this file to .env and adjust as needed. All values have sane defaults for local dev.

# PostgreSQL by default (see README for setup). For quick local testing with zero setup,
# you can point this at SQLite instead: sqlite:///./supplychain.db
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/supplychain

# Change this in any real deployment.
SECRET_KEY=dev-secret-key-change-in-production-9f8a7d6c5b4e3a2f1
